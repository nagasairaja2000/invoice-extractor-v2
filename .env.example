# ---------------------------------------------------------------------------
# Invoice Extractor AI Ã¢â‚¬â€ environment configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file.
# ---------------------------------------------------------------------------

# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Primary model and comma-separated fallbacks (used when a model is unavailable)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=4096

# When OCR output is too sparse, fall back to sending page images to Gemini Vision
ENABLE_GEMINI_VISION_FALLBACK=true

# Upload / processing limits
MAX_FILE_SIZE_MB=15
MAX_PAGES=20
MAX_FILES_PER_REQUEST=10
MAX_CONCURRENT_JOBS=3
JOB_TTL_HOURS=24
MAX_TEXT_CHARS=60000

# OCR (Tesseract). Leave TESSERACT_CMD empty for auto-detection.
# Windows default: C:\Users\<you>\AppData\Local\Programs\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
TESSERACT_LANG=eng
OCR_DPI=300
OCR_MIN_CHARS=40
OCR_PSM=6

# Where uploaded files and result JSON are stored (gitignored)
DATA_DIR=data

# Server
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO
